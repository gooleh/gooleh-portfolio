---
import BaseLayout from "$layouts/BaseLayout.astro";
import BlogPost from "$layouts/BlogPost.astro";
import Navbar from "$components/Navigation/Navbar.svelte";
import { getBlogPosts } from "src/utils";
import type { NotionBlogPost } from "src/utils";
import { marked } from "marked";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: NotionBlogPost };
const { post } = Astro.props;

const html = await marked.parse(post.body);

const formattedDate = post.pubDate
  .toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  .toLowerCase();
---

<BaseLayout title={post.title} description={post.description}>
  <Navbar client:load active="blog" />

  <BlogPost>
    <div class="not-prose mb-4 mt-8">
      <a
        href="/blog"
        class="text-sm text-base-400 hover:text-accent-400 transition-colors"
      >
        ← all posts
      </a>
    </div>

    <div class="not-prose flex items-center gap-x-4 text-xs">
      <time datetime={post.pubDate.toISOString()} class="text-base-400 dark:text-base-500">
        {formattedDate}
      </time>
      <div class="flex flex-wrap gap-x-2 gap-y-1">
        {post.tags.map((tag: string) => (
          <span class="relative z-10 rounded-full bg-base-100 px-3 py-1.5 font-medium text-base-700 dark:bg-base-800 dark:text-base-300 border border-base-200 dark:border-base-700">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <h1 class="mt-4">{post.title}</h1>

    <div set:html={html} />
  </BlogPost>
</BaseLayout>
