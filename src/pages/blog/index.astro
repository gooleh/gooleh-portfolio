---
import BaseLayout from "$layouts/BaseLayout.astro";
import Navbar from "$components/Navigation/Navbar.svelte";
import BlogCard from "$components/Blog/BlogCard.astro";
import { getBlogPosts } from "src/utils";

const posts = await getBlogPosts();
const [featured, ...rest] = posts;
---

<BaseLayout title="blog" description="thoughts on things i'm learning or working on.">
  <Navbar client:load active="blog" />

  <div class="relative isolate overflow-hidden">
    <!-- 배경 글로우 -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[40rem] h-[40rem] rounded-full bg-accent-500/[0.06] blur-3xl pointer-events-none"
    >
    </div>

    <div class="mx-auto max-w-5xl px-6 lg:px-8 py-16 md:py-24">
      <p class="text-sm font-medium text-accent-400 tracking-wide">
        {posts.length} posts
      </p>
      <h1
        class="mt-2 text-4xl sm:text-6xl font-bold tracking-tight bg-gradient-to-br from-base-50 via-base-200 to-base-500 bg-clip-text text-transparent pb-1"
      >
        my ramblings
      </h1>
      <p class="mt-5 max-w-2xl text-base text-base-600 dark:text-base-400">
        here are some of my thoughts on things i'm learning or working on —
        from swift and flutter to blockchain and the web.
      </p>

      <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {featured && <BlogCard post={featured} featured />}
        {rest.map((post) => <BlogCard post={post} />)}
      </div>
    </div>
  </div>
</BaseLayout>
